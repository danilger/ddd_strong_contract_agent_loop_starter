# LangSmith / LangGraph Studio
LANGSMITH_API_KEY=

# Pi agent roles (models for SDK createAgentSession)
# Global `pi` CLI is NOT required — loop2 uses @earendil-works/pi-coding-agent in-process.
ROLE_PLAN_MODEL=deepseek/deepseek-v4-pro
ROLE_CODE_MODEL=deepseek/deepseek-v4-flash
# ROLE_REVIEW_MODEL=  # reserved for later

# Optional default project for LangGraph Studio (when input omits projectPath)
# PROJECT_PATH=D:\projects\loop_test2

# Port for dev servers started by Pi during apply (avoids LangGraph Studio PORT conflict)
# PI_AGENT_PORT=3000

# Windows: force Git Bash for Pi tools (avoids WSL bash without node)
# PI_SHELL_PATH=D:\Programs\Git\bin\bash.exe

# Human-readable Pi console log: thinking, tools, results (set by npm run dev:log)
# PI_VERBOSE=1

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
